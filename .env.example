# Postgres connection string. Local default matches docker-compose.yml (host port 5433).
# In production (Vercel) set this to a hosted Postgres URL (e.g. Neon) in the project env,
# then run the migrations against it once per schema change:
#   DATABASE_URL="<hosted url>" npm run db:migrate
# Used by /api/health and /api/runs (leaderboard). The game page renders without it;
# the leaderboard then shows "offline" and Sessions can't be saved.
DATABASE_URL=postgres://dojo:dojo@localhost:5433/dribble_dojo
